import numpy as np
import pandas as pd

years = np.arange(1960, 2024)

def unemployment_rate(year):
   
    base_rate = 2.5 + ((year - 1960) ** 0.5) * 0.05

      event_impact = {
        1965: 0.2,   # Indo-Pak War
        1973: 0.4,   # Global oil crisis (lowered from 0.5)
        1991: 0.3,   # Economic liberalization (lowered from 0.5)
        2008: 0.3,   # Global financial crisis (less severe for India)
        2016: 0.4,   # Demonetization (marginally adjusted)
        2020: 10.0,  # COVID-19 pandemic (lowered from 15.0)
    }

     base_rate += event_impact.get(year, 0)

      if year > 2020:
        base_rate -= (10 / ((year - 2019) + 2))  # Gradual decline instead of -1% per year

  
    return max(2.5, min(base_rate, 25.0))

unemployment_rates = [unemployment_rate(year) for year in years]

df_unemployment = pd.DataFrame({"Year": years, "Unemployment Rate (%)": unemployment_rates})

df_unemployment.to_csv("unemployment_data_fixed.csv", index=False)

