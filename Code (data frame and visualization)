# 5. Unemployment Data
def unemployment_rate(year):
    base_rate = 2.5 + ((year - 1960) ** 0.5) * 0.05
    event_impact = {
        1965: 0.2,   # Indo-Pak War
        1973: 0.4,   # Global oil crisis
        1991: 0.3,   # Economic liberalization
        2008: 0.3,   # Global financial crisis
        2016: 0.4,   # Demonetization
        2020: 10.0,  # COVID-19 pandemic
    }
    base_rate += event_impact.get(year, 0)
    if year > 2020:
        base_rate -= (10 / ((year - 2019) + 2))  # Gradual decline
    return max(2.5, min(base_rate, 25.0))

unemployment_rates = [unemployment_rate(year) for year in range(1960, 2024)]
df_unemployment = pd.DataFrame({"Year": range(1960, 2024), "Unemployment Rate (%)": unemployment_rates})

